<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="360.0" spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.mrs.GUI.Controller.AuthController" stylesheets="/styles/bootstrap3.css" styleClass="container">
    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>

    <Label fx:id="lblTitle" text="Sign In" styleClass="lg" />
   <VBox prefHeight="49.0" prefWidth="299.0">
      <children>
         <Label text="Username" />
      
          <TextField fx:id="txtUsername" promptText="Username" />
      </children>
   </VBox>
   <VBox prefHeight="41.0" prefWidth="299.0">
      <children>
         <Label text="Password" />
          <PasswordField fx:id="txtPassword" promptText="Password" />
      </children>
   </VBox>
   <VBox fx:id="vbConfirmPassword" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="42.0" prefWidth="300.0" visible="false">
      <children>
         <Label text="Confirm password" />
          <PasswordField fx:id="txtConfirmPassword" managed="false" promptText="Confirm Password" visible="false" />
      </children>
   </VBox>

    <Label fx:id="lblError" managed="false" visible="false" wrapText="true" styleClass=""/>
   <Button fx:id="btnSubmit" mnemonicParsing="false" onAction="#handleSubmit" text="Sign In" styleClass="primary" />

    <HBox alignment="CENTER" spacing="4.0">
        <Label fx:id="lblSwitchPrompt" text="Don't have an account?" />
        <Hyperlink fx:id="linkSwitchMode" onAction="#handleSwitchMode" text="Sign Up" />
    </HBox>
</VBox>
