<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="393.0" prefWidth="567.0" spacing="16.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.mrs.GUI.Controller.MovieViewController">
   <children>
      <HBox alignment="CENTER_RIGHT" prefHeight="22.0" prefWidth="567.0" spacing="12.0">
         <children>
            <TextField fx:id="txtMovieSearch" maxWidth="-Infinity" prefHeight="26.0" prefWidth="182.0" promptText="Search" />
            <Button mnemonicParsing="false" onAction="#onAddMovieClicked" text="Add Movie" />
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </HBox>
      <ListView fx:id="lstMovies" prefHeight="278.0" prefWidth="567.0" />
      <HBox alignment="CENTER_RIGHT" prefHeight="21.0" prefWidth="535.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onDeleteClicked" text="Delete" />
         </children></HBox>
   </children>
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
</VBox>
